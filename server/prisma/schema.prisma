generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id
  name          String
  email         String?
  role          String
  createdAt     DateTime   @default(now())
  seniorLinks   Guardian[] @relation("SeniorGuardians")
  guardianLogin Guardian[] @relation("GuardianProfile")
  mandates      Mandate[]
  payees        Payee[]
  payments      Payment[]
  auditEvents   AuditEvent[]
}

model Guardian {
  id           String  @id @default(cuid())
  seniorId     String
  userId       String?
  name         String
  contact      String
  relationship String
  senior       User    @relation("SeniorGuardians", fields: [seniorId], references: [id], onDelete: Cascade)
  user         User?   @relation("GuardianProfile", fields: [userId], references: [id])
}

model Mandate {
  id         String   @id @default(cuid())
  userId     String
  version    Int
  rawText    String
  policyJson String
  summary    String
  source     String
  active     Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

model Payee {
  id             String   @id @default(cuid())
  userId         String
  displayName    String
  normalizedName String
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@unique([userId, normalizedName])
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  payeeId         String?
  amountCents     Int
  currency        String    @default("USD")
  note            String    @default("")
  status          String
  riskScore       Int?
  riskLevel       String?
  riskReasons     String?
  decision        String?
  paypalOrderId   String?
  paypalAuthId    String?
  paypalCaptureId String?
  idempotencyKey  String?   @unique
  holdExpiresAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payee           Payee?       @relation(fields: [payeeId], references: [id])
  auditEvents     AuditEvent[]
  report          Report?

  @@index([userId, createdAt])
  @@index([status, holdExpiresAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  paymentId String?
  eventType String
  actor     String
  payload   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  payment   Payment? @relation(fields: [paymentId], references: [id])

  @@index([paymentId, createdAt])
}

model Report {
  id        String   @id @default(cuid())
  paymentId String   @unique
  body      String
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id         String   @id
  eventType  String
  payload    String
  receivedAt DateTime @default(now())
}
