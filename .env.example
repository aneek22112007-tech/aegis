# PayPal REST app (sandbox). Leave the id and secret empty to run the in-process demo merchant.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# xAI Grok, OpenAI-compatible. Leave the key empty to compile mandates on device.
XAI_API_KEY=
XAI_MODEL=grok-4

# Server
PORT=8787
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=file:./dev.db

# How long a guardian has to approve a held payment before it is voided.
HOLD_TIMEOUT_MS=900000
